APP_ENV=development
DATABASE_URL=postgresql://user:password@host:5432/dbname
ADMIN_PASSWORD=replace-with-private-password
SESSION_SECRET=replace-with-strong-random-string
PUBLIC_URL=

# M-Pesa STK Push - disabled until verified Daraja merchant credentials are set
DARAJA_ENABLED=false
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
# This is the approved HO/store shortcode, NOT the customer-facing Till.
DARAJA_STORE_SHORTCODE=
# Customer-facing Till is fixed to 3340030
